@page
@using wt_lab12_12auth_validation_savostikova.Pages
@model LoginModel

<h1>Вход</h1>

<form method="post">
    <div asp-validation-summary="All" style="color: red;"></div>

    <div style="margin-bottom: 15px;">
        <label asp-for="Login">Логин</label><br />
        <input asp-for="Login" />
        <br />
        <span asp-validation-for="Login" style="color: red;"></span>
    </div>

    <div style="margin-bottom: 15px;">
        <label asp-for="Password">Пароль</label><br />
        <input asp-for="Password" type="password" />
        <br />
        <span asp-validation-for="Password" style="color: red;"></span>
    </div>

    <button type="submit">Войти</button>
</form>